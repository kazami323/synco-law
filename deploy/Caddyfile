(security) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
}

{$API_DOMAIN} {
	import security
	reverse_proxy backend:8000
}

{$APP_DOMAIN} {
	encode zstd gzip
	# Next.js сам выставляет CSP/HSTS/X-Frame-Options (next.config headers),
	# поэтому snippet security здесь не импортируем — иначе задвоятся заголовки.
	reverse_proxy frontend:3000
}
