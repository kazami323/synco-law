APP_NAME=AI Legal Workspace
APP_VERSION=0.1.0
ENVIRONMENT=development
APP_DEBUG=false

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
AUTH_COOKIE_NAME=auth_token
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
PUBLIC_APP_URL=http://localhost:3000

DATABASE_URL=postgresql+asyncpg://legal_user:secure_password@localhost:5432/legal_workspace
REDIS_URL=redis://localhost:6379/0
ELASTICSEARCH_URL=http://localhost:9200

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=contracts
MINIO_SECURE=false

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
ANTHROPIC_TIMEOUT_SECONDS=90
AI_REQUESTS_PER_MINUTE=10
AI_DAILY_REQUESTS_PER_ORG=500
AI_DAILY_TOKENS_PER_ORG=2000000
# Локальный Legal RAG парсит публичный HTML lex.uz без ключа.
# Оставлено только для возможной будущей официальной интеграции.
LEX_UZ_API_KEY=
LEGAL_REFRESH_ENABLED=false
LEGAL_REFRESH_INTERVAL_HOURS=168
LEXUZ_CACHE_DIR=.cache/lexuz

EMAIL_NOTIFY=false
CORS_ORIGINS=["http://localhost:3000"]

# --- Уведомления (Phase 2+) ---
# Email через SMTP; пустой SMTP_HOST = канал выключен
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=AI Legal Workspace <noreply@legal.uz>
SMTP_TLS=true

# Telegram-бот (создайте через @BotFather); пустой токен = канал выключен
TELEGRAM_BOT_TOKEN=

# --- E-IMZO ---
# Серверная проверка PKCS#7 (развёрнутый e-imzo-server/DSV); пусто = без проверки
EIMZO_DSV_URL=
EIMZO_REQUIRE_CONTENT_BINDING=true
ALLOW_STUB_SIGNATURES=true
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=false
RUN_BACKGROUND_JOBS=true
